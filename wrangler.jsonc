{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chat95",
  "account_id": "07c0af05c26ba496132943e2ce718337",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "chat95.ethandenny.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "OPENROUTER_MODEL": "stealth/union-alpha"
  },
  "secrets": {
    "required": [
      "OPENROUTER_API_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "9501",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "SITE_RATE_LIMIT",
      "namespace_id": "9502",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
